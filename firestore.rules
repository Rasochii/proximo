rules_version = '2';

// Próximo! — Security Rules
// Princípios (ADR 0004):
//  • deny-by-default;
//  • NENHUMA escrita do cliente: toda mutação passa pelas Cloud Functions (Admin SDK ignora estas regras);
//  • leitura mínima: projeção pública para todos, agregado do dia só para a equipe,
//    ticket ativo só para o próprio usuário.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isActiveMember(shopId) {
      let path = /databases/$(database)/documents/shops/$(shopId)/members/$(request.auth.uid);
      return signedIn() && exists(path) && get(path).data.active == true;
    }

    // Perfil público da barbearia: nome, horários, serviços.
    match /shops/{shopId} {
      allow get, list: if true;
      allow write: if false;

      match /members/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || isActiveMember(shopId));
        allow list: if isActiveMember(shopId);
        allow write: if false;
      }

      // Agregado da fila do dia: contém nomes completos e UIDs → só a equipe.
      match /days/{dateKey} {
        allow read: if isActiveMember(shopId);
        allow write: if false;
      }

      match /private/{docId} {
        allow read: if isActiveMember(shopId);
        allow write: if false;
      }
    }

    // Projeção pública (sem dados pessoais): cliente, link web e TV.
    match /publicQueues/{shopId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    // Ticket ativo: só o próprio usuário enxerga.
    match /activeTickets/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Tudo o mais (rateLimits, coleções futuras) é negado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
