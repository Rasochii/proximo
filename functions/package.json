{
  "name": "proximo-functions",
  "version": "0.1.0",
  "private": true,
  "description": "Backend da fila virtual Próximo! (Cloud Functions + domínio puro em TypeScript)",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "tsx --test test/*.test.ts",
    "test:coverage": "tsx --test --experimental-test-coverage --test-coverage-include=src/domain/** test/*.test.ts",
    "pretest:emulator": "npm run build",
    "test:emulator": "firebase emulators:exec --project demo-proximo --only auth,firestore,functions \"tsx --test test-emulator/*.test.ts\"",
    "serve": "npm run build && firebase emulators:start --project demo-proximo",
    "seed": "tsx scripts/seed-emulator.ts",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/node": "^22.17.0",
    "eslint": "^9.33.0",
    "firebase": "^11.10.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.39.0"
  }
}
